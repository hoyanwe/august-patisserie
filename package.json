{
  "name": "august-patisserie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/patch-node-modules.mjs",
    "preview": "npm run prebuild && opennextjs-cloudflare build --openNextConfigPath ./open-next.config.ts && opennextjs-cloudflare preview",
    "deploy": "npm run prebuild && opennextjs-cloudflare build --openNextConfigPath ./open-next.config.ts && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply august-patisserie-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply august-patisserie-db --local"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260206.0",
    "@opennextjs/cloudflare": "^1.16.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.63.0"
  }
}
